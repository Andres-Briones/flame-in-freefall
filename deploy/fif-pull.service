# Copy to /etc/systemd/system/; User and the path are those of the demo server, change them elsewhere (demo/README.md, "Automatic deploy").
[Unit]
Description=Flame in Freefall: deploy main when GitHub has a new commit
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=andres
ExecStart=/srv/home/users/open-poker.ch/andres/projects/flame-in-freefall/deploy/pull.sh
TimeoutStartSec=30min
